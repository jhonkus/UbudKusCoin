<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Reflection-based serializers and generated gRPC code are not trim-safe yet. -->
    <PublishTrimmed>false</PublishTrimmed>
    <UserSecretsId>30e6811d-fd4d-4923-9f26-64173fb52774</UserSecretsId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'UbudKusCoin' ">
    <ExternalConsole>true</ExternalConsole>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UbudKusCoin.Core\UbudKusCoin.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.83.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.83.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NBitcoin" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.10" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\account.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\block.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\canonical_block.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\cometbft_abci.proto" GrpcServices="Server" />
    <Protobuf Include="Protos\peer.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\stake.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\transaction.proto" GrpcServices="Server, Client" />
    <Protobuf Include="Protos\read_model.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <None Include="**/*" />
  </ItemGroup>
</Project>
