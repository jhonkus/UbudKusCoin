<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core protocol types & canonical hashing. No I/O, no gRPC. NBitcoin is
       used ONLY for audited secp256k1 ECDSA (the built-in .NET ECDsa does not
       support secp256k1). We never invent our own crypto. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBitcoin" Version="10.0.7" />
  </ItemGroup>

</Project>
